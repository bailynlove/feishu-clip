{
  "manifest_version": 3,
  "name": "先存飞书",
  "version": "0.1.0",
  "description": "先进团队，先存飞书——一键将当前网页剪藏为飞书知识库文档",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["http://127.0.0.1:38479/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "保存到飞书", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "options_page": "options.html"
}
